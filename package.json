  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ousnah/Meditrack.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "setup": "npm run install:all",
    "setup:start": "npm run install:all && npm start",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "start": "npm run dev",
    "dev": "sh scripts/dev.sh",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .js,.mjs,.cjs,.vue",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs,.vue --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,css,vue,md}\"",
    "check-format": "prettier --check \"**/*.{js,mjs,cjs,json,css,vue,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.1.0",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "font-awesome": "^4.7.0",
    "vue-router": "^5.0.7"
  }
}
